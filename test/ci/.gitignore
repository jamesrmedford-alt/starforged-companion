# Credentials live in macOS Keychain (see scripts/credentials.sh), not in
# any file. .env is ignored as defense-in-depth in case someone makes one.
.env

# Bind-mounted Foundry userData. Contains the licensed Foundry zip,
# downloaded systems/modules, and any worlds you create. Never commit.
data/

# Cypress artifacts — screenshots / videos from failed e2e runs.
cypress/artifacts/

# Second-client suite: its npm install (inside the Playwright container) and
# its failure screenshots.
playwright/node_modules/
playwright/artifacts/
